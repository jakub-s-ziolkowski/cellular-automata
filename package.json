{
    "name": "cellular-automata",
    "version": "1.0.0",
    "description": "",
    "main": "dist/main/main.js",
    "scripts": {
        "dev": "webpack serve --config webpack.dev.js",
        "build:renderer": "webpack --config webpack.prod.js",
        "build:main": "tsc -p tsconfig.main.json",
        "electron:dev": "concurrently -k \"webpack serve --config webpack.dev.js\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 dist/main/main.js && cross-env NODE_ENV=development electron .\"",
        "build": "npm run build:renderer && npm run build:main && electron-builder",
        "wasm:build": "cd src/rust && wasm-pack build --target web --out-dir ../renderer/wasm"
    },
    "build": {
        "appId": "com.sicarios.cellularautomata",
        "productName": "CellularAutomata",
        "files": [
            "dist/**/*",
            "dist-renderer/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@svgr/webpack": "^8.1.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "concurrently": "^10.0.4",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "html-webpack-plugin": "^5.6.8",
        "mini-css-extract-plugin": "^2.10.2",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "wait-on": "^9.1.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
